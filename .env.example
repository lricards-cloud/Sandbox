# Copy to .env and fill in. NEVER commit your real .env.
# Only required for LIVE trading. Paper mode needs none of these.

# Your Polygon wallet private key (hex, with or without 0x). Funds the copy trades.
POLYMARKET_PRIVATE_KEY=

# Optional: the Polymarket "proxy"/funder address associated with your account.
# Found in the Polymarket UI. Leave blank to derive from the key (EOA signer).
POLYMARKET_FUNDER_ADDRESS=

# CLOB API credentials (L2). If blank, the client derives them from your key.
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
